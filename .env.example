# Wachtwoord voor de site. Leeg laten = geen poort (handig lokaal).
SITE_PASSWORD=

# Optioneel: eigen geheim voor de cookie-handtekening. Zonder deze wordt het wachtwoord gebruikt.
AUTH_SECRET=

# Vercel Blob. Wordt automatisch gezet als je in Vercel een Blob store koppelt
# (BLOB_STORE_ID via OIDC, of een BLOB_READ_WRITE_TOKEN). Lokaal: `vercel env pull .env.local`
# of leeg laten om in .data/ te werken.
BLOB_READ_WRITE_TOKEN=

# Optioneel: "private" of "public". Zonder deze waarde probeert de app het zelf uit.
BLOB_ACCESS=

# Optioneel, alleen lokaal: pad naar een Chromium/Chrome als er geen Chrome geïnstalleerd is.
CHROME_PATH=
